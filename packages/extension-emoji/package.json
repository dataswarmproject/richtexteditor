  "keywords": [
    "digitaltrendz",
    "inkflow extension"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/digital-trendz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-trendz/inkflow",
    "directory": "packages/extension-emoji"
  },
  "type": "module",
  "exports": {
    ".": {
