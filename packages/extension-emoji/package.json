    "emojibase-data": "^15",
    "is-emoji-supported": "^0.0.5"
  },
  "devDependencies": {
    "@digitaltrendz/core": "workspace:^",
    "@digitaltrendz/pm": "workspace:^",
    "@digitaltrendz/suggestion": "workspace:^",
