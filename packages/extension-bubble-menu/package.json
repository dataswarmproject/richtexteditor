{
  "name": "@digitaltrendz/extension-bubble-menu",
  "description": "bubble-menu extension for tiptap",
  "version": "3.14.0",
  "homepage": "https://digitaltrendz.app",
  "keywords": [
    "digitaltrendz",
    "inkflow extension"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/digital-trendz"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-trendz/inkflow",
    "directory": "packages/extension-bubble-menu"
  },
  "sideEffects": false,
  "devDependencies": {
    "@digitaltrendz/core": "workspace:^",
    "@digitaltrendz/pm": "workspace:^"
  },
  "dependencies": {
