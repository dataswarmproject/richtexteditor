{
  "name": "@digitaltrendz/html",
  "description": "utility package to render inkflow JSON as HTML",
  "version": "3.14.0",
  "homepage": "https://digitaltrendz.app",
  "keywords": [
    "digitaltrendz",
    "inkflow utility"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/digital-trendz"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": {
        "browser": "./dist/index.js",
        "node": "./dist/server/index.js",
        "default": "./dist/index.js"
      },
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": {
        "import": "./dist/server/index.d.ts",
        "require": "./dist/server/index.d.cts"
      },
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@digitaltrendz/core": "workspace:^",
    "@digitaltrendz/pm": "workspace:^",
    "happy-dom": "^20.0.2"
  },
  "peerDependencies": {
    "@digitaltrendz/core": "workspace:^",
    "@digitaltrendz/pm": "workspace:^",
    "happy-dom": "^20.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-trendz/inkflow",
    "directory": "packages/html"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  },
  "author": "Digital Trendz <hello@digital-trendz.net> (https://digital-trendz.net)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/digital-trendz/inkflow/issues"
  }
}
