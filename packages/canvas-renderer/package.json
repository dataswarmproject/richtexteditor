{
  "name": "@digitaltrendz/canvas-renderer",
  "description": "Canvas-based document renderer with PDF/print export for Digital Trendz editors",
  "version": "3.14.0",
  "homepage": "https://digitaltrendz.app",
  "keywords": [
    "digitaltrendz",
    "canvas",
    "pdf",
    "print",
    "document-renderer",
    "rich-text-editor",
    "export"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@hufe921/canvas-editor": "^0.9.100"
  },
  "peerDependencies": {
    "@digitaltrendz/core": "workspace:^"
  },
  "devDependencies": {
    "@digitaltrendz/core": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-trendz/inkflow",
    "directory": "packages/canvas-renderer"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  },
  "author": "Digital Trendz <hello@digital-trendz.net> (https://digital-trendz.net)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/digital-trendz/inkflow/issues"
  }
}
