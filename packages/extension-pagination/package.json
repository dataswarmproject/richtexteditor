{
  "name": "@tiptap/extension-pagination",
  "description": "Google Docs-like pagination extension for tiptap",
  "version": "3.14.0",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "pagination",
    "page-break",
    "document",
    "google-docs"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@tiptap/core": "workspace:^",
    "@tiptap/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension-pagination"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
