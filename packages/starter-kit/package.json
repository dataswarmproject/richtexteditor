{
  "name": "@digitaltrendz/starter-kit",
  "description": "starter kit for tiptap",
  "version": "3.14.0",
  "homepage": "https://digitaltrendz.app",
  "keywords": [
    "digitaltrendz",
    "inkflow starter kit"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/digital-trendz"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@digitaltrendz/core": "workspace:^",
    "@digitaltrendz/extension-blockquote": "workspace:^",
    "@digitaltrendz/extension-bold": "workspace:^",
    "@digitaltrendz/extension-bullet-list": "workspace:^",
    "@digitaltrendz/extension-code": "workspace:^",
    "@digitaltrendz/extension-code-block": "workspace:^",
    "@digitaltrendz/extension-document": "workspace:^",
    "@digitaltrendz/extension-dropcursor": "workspace:^",
    "@digitaltrendz/extension-gapcursor": "workspace:^",
    "@digitaltrendz/extension-hard-break": "workspace:^",
    "@digitaltrendz/extension-heading": "workspace:^",
    "@digitaltrendz/extension-horizontal-rule": "workspace:^",
    "@digitaltrendz/extension-italic": "workspace:^",
    "@digitaltrendz/extension-link": "workspace:^",
    "@digitaltrendz/extension-list": "workspace:^",
    "@digitaltrendz/extension-list-item": "workspace:^",
    "@digitaltrendz/extension-list-keymap": "workspace:^",
    "@digitaltrendz/extension-ordered-list": "workspace:^",
    "@digitaltrendz/extension-paragraph": "workspace:^",
    "@digitaltrendz/extension-strike": "workspace:^",
    "@digitaltrendz/extension-text": "workspace:^",
    "@digitaltrendz/extension-underline": "workspace:^",
    "@digitaltrendz/extensions": "workspace:^",
    "@digitaltrendz/pm": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digital-trendz/inkflow",
    "directory": "packages/starter-kit"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  },
  "author": "Digital Trendz <hello@digital-trendz.net> (https://digital-trendz.net)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/digital-trendz/inkflow/issues"
  }
}
